# =========================================================
# Qdrant
# =========================================================
QDRANT_URL=http://localhost:6333

# Pipeline JavaScript (Gemini)
QDRANT_COLLECTION=kcda_knowledge

# Pipeline Python (NVIDIA + PaddleOCR)
NVIDIA_QDRANT_COLLECTION=kcda_knowledge_nvidia_v4

# =========================================================
# Embedding / chat model
# =========================================================
NVIDIA_API_KEY=isi_api_key_nvidia_di_sini
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# =========================================================
# Retrieval
# =========================================================
RETRIEVAL_SCORE_THRESHOLD=0.35
RETRIEVAL_GLOSSARY_THRESHOLD=0.25
RAG_TOP_K=5

# =========================================================
# Pipeline JavaScript (Gemini)
# =========================================================
GOOGLE_API_KEY=isi_api_key_google_di_sini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash
RETRIEVAL_TOP_K=5
