# =========================================================
# Qdrant
# =========================================================
QDRANT_URL=http://localhost:6333

# Pipeline JavaScript (Gemini)
QDRANT_COLLECTION=kcda_knowledge

# Pipeline Python (NVIDIA + PaddleOCR)
NVIDIA_QDRANT_COLLECTION=kcda_knowledge_nvidia_v4

# =========================================================
# Generation NVIDIA NIM (API Python)
# =========================================================
NVIDIA_API_KEY=isi_api_key_nvidia_di_sini
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Alias lama; dipakai hanya jika NVIDIA_MODEL kosong.
# NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_TIMEOUT_SECONDS=60
NVIDIA_MAX_RETRIES=3
NVIDIA_DISABLE_THINKING=true

# =========================================================
# Embedding (jangan diubah)
# =========================================================
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# =========================================================
# API Python (dipanggil oleh Node.js)
# =========================================================
PYTHON_API_URL=http://127.0.0.1:8000
PYTHON_API_TIMEOUT_MS=60000

# =========================================================
# Retrieval
# =========================================================
RETRIEVAL_SCORE_THRESHOLD=0.35
RETRIEVAL_GLOSSARY_THRESHOLD=0.25
RAG_TOP_K=5

# =========================================================
# Pipeline JavaScript (Gemini)
# =========================================================
GOOGLE_API_KEY=isi_api_key_google_di_sini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash
RETRIEVAL_TOP_K=5
